
[Unit]
Description=Amlicode Spring Boot Application
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes

WorkingDirectory=/opt/amlicode

ExecStart=/usr/bin/docker compose -f deploy/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.yml down

TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
